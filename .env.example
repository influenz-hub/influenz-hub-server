# Server
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000

# Database
DATABASE_URL="postgresql://influenz:influenz@localhost:5432/influenz_hub"

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_PEPPER=""
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email magic links (https://resend.com/api-keys)
RESEND_API_KEY=""
EMAIL_FROM="Influenz Hub <onboarding@resend.dev>"

# Phone OTP (Twilio) — not yet wired; codes are logged to the console in dev
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Background jobs — set true to run cron inside the API process
ENABLE_CRON=false
