generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  USER
  BUSINESS
  ADMIN
}

enum TargetType {
  PROFILE
  STORE
  PRODUCT
  SERVICE
  POST
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  REVIEW
  NEW_PRODUCT
  NEW_POST
  VERIFIED
  FEATURED
}

// ---------- Identity & auth ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?   @unique
  phoneVerified DateTime?
  dateOfBirth   DateTime?
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile         Profile?
  oauthAccounts   OAuthAccount[]
  refreshTokens   RefreshToken[]
  comments        Comment[]
  likes           Like[]
  follows         Follow[]
  reviews         Review[]
  notifications   Notification[]
  recommendations Recommendation[]
  viewEvents      ViewEvent[]
  reports         Report[]

  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Opaque refresh tokens, stored hashed and rotated on every use.
/// `familyId` groups a login session's rotations so reuse of a consumed
/// token can revoke the whole family (stolen-token detection).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("phone_otps")
}

model EmailLoginToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("email_login_tokens")
}

// ---------- Catalog ----------

model Category {
  id   String  @id @default(cuid())
  name String  @unique
  slug String  @unique
  icon String?

  profiles Profile[]
  stores   Store[]
  products Product[]
  services Service[]

  @@map("categories")
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  businessName String
  slug         String   @unique
  logo         String?
  banner       String?
  description  String?
  categoryId   String?
  location     String?
  contactEmail String?
  contactPhone String?
  socialLinks  Json?
  verified     Boolean  @default(false)
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
  stores   Store[]
  services Service[]
  posts    Post[]

  @@index([categoryId])
  @@map("profiles")
}

model Store {
  id           String   @id @default(cuid())
  profileId    String
  name         String
  slug         String   @unique
  description  String?
  images       String[]
  location     String?
  openingHours Json?
  contactInfo  String?
  categoryId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile  Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
  products Product[]
  posts    Post[]

  @@index([profileId])
  @@index([categoryId])
  @@map("stores")
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  slug        String   @unique
  description String?
  images      String[]
  price       Decimal  @db.Decimal(10, 2)
  categoryId  String?
  stock       Int      @default(0)
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
  posts    Post[]

  @@index([storeId])
  @@index([categoryId])
  @@map("products")
}

model Service {
  id            String   @id @default(cuid())
  profileId     String
  name          String
  slug          String   @unique
  description   String?
  images        String[]
  priceMin      Decimal? @db.Decimal(10, 2)
  priceMax      Decimal? @db.Decimal(10, 2)
  categoryId    String?
  contactMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile  Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([profileId])
  @@index([categoryId])
  @@map("services")
}

model Post {
  id        String   @id @default(cuid())
  profileId String
  text      String
  images    String[]
  storeId   String?
  productId String?
  createdAt DateTime @default(now())

  profile Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  store   Store?   @relation(fields: [storeId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([profileId])
  @@index([storeId])
  @@map("posts")
}

// ---------- Polymorphic engagement ----------

model Follow {
  id         String     @id @default(cuid())
  userId     String
  targetType TargetType
  targetId   String
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("follows")
}

model Like {
  id         String     @id @default(cuid())
  userId     String
  targetType TargetType
  targetId   String
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("likes")
}

model Comment {
  id         String     @id @default(cuid())
  userId     String
  targetType TargetType
  targetId   String
  text       String
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId, createdAt])
  @@map("comments")
}

model Review {
  id         String     @id @default(cuid())
  userId     String
  targetType TargetType
  targetId   String
  rating     Int
  text       String?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("reviews")
}

// ---------- Notifications, recommendations, analytics ----------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  payload   Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model Recommendation {
  id          String     @id @default(cuid())
  userId      String
  targetType  TargetType
  targetId    String
  score       Float
  generatedAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId, score])
  @@map("recommendations")
}

model ViewEvent {
  id         String     @id @default(cuid())
  targetType TargetType
  targetId   String
  userId     String?
  createdAt  DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@map("view_events")
}

model DailyStat {
  id         String     @id @default(cuid())
  targetType TargetType
  targetId   String
  date       DateTime   @db.Date
  views      Int        @default(0)
  likes      Int        @default(0)
  followers  Int        @default(0)
  comments   Int        @default(0)

  @@unique([targetType, targetId, date])
  @@map("daily_stats")
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  targetType TargetType
  targetId   String
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("reports")
}
